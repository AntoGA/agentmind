# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Optional: Alternative embedding provider
# ANTHROPIC_API_KEY=your-key-here
# HUGGINGFACE_API_KEY=your-token-here

# Database connections (if using PostgreSQL/Redis)
# POSTGRES_URL=postgresql://user:pass@localhost:5432/agentmind
# REDIS_URL=redis://localhost:6379

# Configuration
AGENTMIND_STORAGE=sqlite  # sqlite, postgresql, redis, chromadb
AGENTMIND_DB_PATH=./agent_memory.db
AGENTMIND_EMBEDDING_MODEL=text-embedding-3-small
AGENTMIND_MAX_MEMORIES=10000
